# API — browser and host-side `npm run dev` (localhost)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DATA_SOURCE=api
# INTERNAL_API_URL is injected by docker-compose only (http://backend:8000). Do not add here.

# Supabase (auth + hub)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Temporary dev bypass. Set true to skip auth route guards.
# TODO(auth): remove once auth is working end-to-end.
NEXT_PUBLIC_BYPASS_AUTH=false
