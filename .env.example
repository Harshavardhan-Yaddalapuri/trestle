# ═══════════════════════════════════════════
# Trestle — Environment Variables
# Copy to .env and fill in your keys
# ═══════════════════════════════════════════

# ── Supabase (PostgreSQL + Auth) ──────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
# Database password (Dashboard → Project Settings → Database — not the service key)
SUPABASE_DB_PASSWORD=your-database-password
# Region from Dashboard → Connect → Pooler (default us-east-1)
SUPABASE_DB_REGION=us-east-1
# Optional: override pooler host from Dashboard → Connect
# SUPABASE_DB_POOLER_HOST=aws-0-us-east-1.pooler.supabase.com
# Optional: full SQLAlchemy URL override (postgres:// or postgresql+asyncpg://)
# DATABASE_URL=postgresql+asyncpg://postgres.[ref]:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ── Ollama (local LLM) ───────────────────────────────
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=deepseek-v4-pro

# ── Redis ────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Admin endpoints hardening ────────────────────────
# Required in non-development environments.
ADMIN_API_KEY=replace-with-strong-random-token

# ── Frontend ─────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Optional: external API providers ────────────────
# DEEPSEEK_API_KEY=your-deepseek-key
# OPENAI_API_KEY=your-openai-key
# ANTHROPIC_API_KEY=your-anthropic-key
# TAVILY_API_KEY=your-tavily-key
# FIRECRAWL_API_KEY=your-firecrawl-key

# ── Multi-provider LLM fallback ──────────────────────
# LLM_PRIMARY=deepseek
# LLM_FALLBACKS=gemini,nvidia
# GEMINI_API_KEY=your-gemini-key
# GEMINI_MODEL=gemini-2.0-flash
# NVIDIA_API_KEY=your-nvidia-key
# NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# ── Founder events discovery ──────────────────────────
# Enable periodic web discovery of startup events from JSON-LD pages.
EVENTS_ENABLED=false
EVENTS_DISCOVERY_INTERVAL_HOURS=12
EVENTS_HTTP_TIMEOUT_SECONDS=20
EVENTS_REDIS_LOCK_TTL_SECONDS=1800
# Comma-separated event listing pages that expose schema.org Event JSON-LD.
# Example:
# EVENTS_SOURCE_URLS=https://www.startupgrind.com/events/,https://www.techstars.com/events
EVENTS_SOURCE_URLS=

# ── Supabase Auth redirect URLs ──────────────────────
# Add these in Supabase Dashboard → Auth → URL Configuration
#   Site URL: http://localhost:3000
#   Redirect URLs: http://localhost:3000/auth/callback
