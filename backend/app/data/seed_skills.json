[
  {
    "slug": "grant-intelligence",
    "name": "Grant Intelligence",
    "description": "Find, track, and manage grant applications for your medtech/biotech startup. Matches your company profile against a curated database of SBIR/STTR, foundation, and state-level funding opportunities. Provides lifecycle tracking across 14 states from discovery through award.",
    "status": "live",
    "required_profile_fields": [
      "company_name",
      "incorporation_type",
      "incorporation_country",
      "location_city",
      "location_state",
      "location_country",
      "team_size",
      "industry_tags",
      "product_type",
      "therapeutic_area",
      "data_status",
      "regulatory_pathway",
      "monthly_burn_usd",
      "runway_months",
      "last_raise_amount_usd",
      "capital_need_12m_usd",
      "company_age_months",
      "revenue_usd",
      "has_ip_license",
      "prior_sbir_awards",
      "sbir_eligible",
      "minimum_grant_size_usd",
      "geographic_scope"
    ],
    "config_json": {
      "version": "1.0.0",
      "match_engine": "eligibility_rules_jsonb",
      "max_matches_per_query": 5,
      "require_source_url": true,
      "lifecycle_states": 14,
      "eligible_lifecycle_states": [
        "discovered",
        "saved",
        "interested",
        "started",
        "applied",
        "submitted",
        "under_review",
        "accepted",
        "awarded",
        "rejected",
        "reconsidering",
        "dismissed",
        "abandoned",
        "archived"
      ],
      "alert_types": [
        "new_grant_match",
        "deadline_approaching",
        "deadline_imminent",
        "deadline_passed",
        "review_halfway",
        "decision_expected",
        "decision_overdue",
        "reconsideration_window",
        "no_activity",
        "grant_updated",
        "profile_change_unlock",
        "re_engagement"
      ],
      "conversation_intents": [
        "greet",
        "discover",
        "match_request",
        "deep_dive",
        "grant_question",
        "dismiss",
        "lifecycle_action"
      ],
      "matching_rules_file": "seed_rules.json",
      "grants_data_file": "seed_grants.json",
      "completeness_threshold": 0.7,
      "sources": [
        "NIH SBIR",
        "NIH NCI",
        "NIH NIAID",
        "NIH NIBIB",
        "NIH NCATS",
        "NIH NHLBI",
        "NIH NINDS",
        "NSF SBIR",
        "BARDA DRIVe",
        "Gates Foundation",
        "PCORI",
        "Michigan MEDC",
        "FDA"
      ]
    }
  }
]
